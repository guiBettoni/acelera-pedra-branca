# Copie para .env e preencha com os valores reais

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# CORS: origem permitida em produção (ex: https://usuario.github.io)
# Deixe em branco para aceitar qualquer origem (apenas em desenvolvimento)
CORS_ORIGIN=

# ── Autenticação do painel admin ────────────────────────────────────────────
# Credenciais do administrador — usadas no login do painel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=senha_segura_aqui

# Token secreto retornado após login bem-sucedido.
# Gere uma string aleatória longa (ex: openssl rand -hex 32)
# Se não configurado, os endpoints de escrita ficam SEM proteção.
ADMIN_TOKEN=gere_uma_string_aleatoria_longa_aqui
